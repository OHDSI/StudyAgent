{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow_context_dialogue_output",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "current_step_guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "permission_required": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact_id",
          "reason",
          "permission_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "plan",
    "answer",
    "current_step_guidance",
    "cautions",
    "suggested_next_actions",
    "follow_up_plan",
    "artifact_requests"
  ],
  "additionalProperties": false
}
