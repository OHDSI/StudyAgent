LLM_LOG=1
LLM_MODEL=
LLM_LOG_RESPONSE=1
LLM_USE_RESPONSES=0

LLM_API_KEY=                                                                                                                                      
LLM_API_URL=<host URL>/v1/chat/completions
LLM_MODEL=

EMBED_API_KEY=
EMBED_MODEL=
EMBED_URL=<host URL>/ollama/api/embed
EMBED_TIMEOUT=60                                                                                                                      

MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8790
MCP_PATH=/mcp

PHENOTYPE_INDEX_DIR=$PWD/data/phenotype_index

STUDY_AGENT_LOG_DIR=$PWD/study-agent-logs
ACP_LOG_LEVEL=DEBUG
MCP_LOG_LEVEL=DEBUG

STUDY_AGENT_HOST=127.0.0.1
STUDY_AGENT_PORT=8765
STUDY_AGENT_ALLOW_CORE_FALLBACK=0
STUDY_AGENT_DEBUG=1
STUDY_AGENT_MCP_ONESHOT=1
STUDY_AGENT_MCP_URL="http://127.0.0.1:8790/mcp"
STUDY_AGENT_MCP_CWD=$PWD


ACP_TIMEOUT=180
LLM_TIMEOUT=120
STUDY_AGENT_MCP_TIMEOUT=80
EMBED_TIMEOUT=60

STUDY_AGENT_REWRITE_CONTAINER_HOSTS=0

